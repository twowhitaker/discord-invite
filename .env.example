# Optional public JSON feed for richer live server data.
# Do NOT put a Discord bot token in any VITE_* variable; Vite exposes it to users.
VITE_COMMUNITY_STATUS_URL=https://example.com/twowhit-status.json

# Optional default layout: full or compact.
# You can always override this at runtime with ?layout=full or ?layout=compact.
VITE_WIDGET_LAYOUT=full
